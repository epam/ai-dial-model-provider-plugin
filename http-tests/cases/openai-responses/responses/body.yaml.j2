# The body of create and input_tokens: forwarded byte for byte (DIAL file URLs not resolved), or refused with a 400
# before anything is sent. The message wording of a parser's reason is not pinned.
{% set bad = [
  ["empty body", "", "The request body is empty"],
  ["trailing data", "{\"model\":\"x\"} {}", "The request body is not valid JSON: data follows the object"],
  ["null body", "null", "The request body must be a JSON object, not null"],
  ["string body", "\"x\"", "The request body must be a JSON object, not a string"],
  ["number body", "0", "The request body must be a JSON object, not a number"],
  ["boolean body", "false", "The request body must be a JSON object, not a boolean"],
] %}
{% for route in ["create", "input_tokens"] %}
{% set path = "/openai/v1/responses" ~ ("/input_tokens" if route == "input_tokens" else "") %}
{% for title, body, message in bad %}
---
name: {{ (route ~ " " ~ title) | tojson }}
request: {path: {{ path | tojson }}, body: {{ body | tojson }}}
mocks: []
expect:
  status: 400
  json: {error: {message: {{ message | tojson }}, type: invalid_request_error, code: '400'}}
{% endfor %}
{% for title, body in [["truncated body", "{\"model\":"], ["NaN", "{\"a\":NaN}"]] %}
---
name: {{ (route ~ " " ~ title) | tojson }}
request: {path: {{ path | tojson }}, body: {{ body | tojson }}}
mocks: []
expect:
  status: 400
  json: {error: {message: {$regex: '^The request body is not valid JSON: .+'}, type: invalid_request_error, code: '400'}}
{% endfor %}
{% endfor %}
{% for route in ["create", "input_tokens"] %}
---
name: {{ (route ~ " model that is not a string") | tojson }}
request:
  path: {{ ("/openai/v1/responses" ~ ("/input_tokens" if route == "input_tokens" else "")) | tojson }}
  body: '{"model":7,"input":"hi"}'
mocks: []
expect:
  status: 400
  json: {error: {message: '"model" must be a string, but is a number', type: invalid_request_error, code: '400'}}
{% endfor %}
{% for title, value, kind in [["array", "[]", "an array"], ["object", "{}", "an object"], ["string", "\"yes\"", "a string"], ["number", "1", "a number"]] %}
---
name: {{ ("stream that is " ~ kind) | tojson }}
request: {body: {{ ('{"model":"gpt-5","stream":' ~ value ~ ',"input":"hi"}') | tojson }}}
mocks: []
expect:
  status: 400
  json: {error: {message: {{ ('"stream" must be a boolean, but is ' ~ kind) | tojson }}, type: invalid_request_error, code: '400'}}
{% endfor %}
---
name: body forwarded byte for byte with a text content type
request:
  headers: {Content-Type: text/plain}
  body: '{ "model" : "gpt-5", "stream" : false, "input":[{"role":"user","content":"é"}] }'
mocks:
- request:
    headers: {content-type: application/json}
    body: '{ "model" : "gpt-5", "stream" : false, "input":[{"role":"user","content":"é"}] }'
---
name: DIAL file URLs are not resolved
server: {env: {DIAL_URL: 'http://127.0.0.1:1'}}
request:
  headers: {Api-Key: dk}
  body: '{"model":"m","input":[{"role":"user","content":[{"type":"input_image","image_url":"files/b/a.png"},{"type":"input_file","file_url":"files/b/a.pdf","filename":"a.pdf"}]}]}'
mocks:
- request: {body: '{"model":"m","input":[{"role":"user","content":[{"type":"input_image","image_url":"files/b/a.png"},{"type":"input_file","file_url":"files/b/a.pdf","filename":"a.pdf"}]}]}'}
---
name: DIAL file URL in a tool output is not resolved
server: {env: {DIAL_URL: 'http://127.0.0.1:1'}}
request:
  body: '{"input":[{"type":"function_call_output","call_id":"c","output":[{"type":"input_image","image_url":"files/b/a.png"}]}]}'
mocks:
- request: {body: '{"input":[{"type":"function_call_output","call_id":"c","output":[{"type":"input_image","image_url":"files/b/a.png"}]}]}'}
---
name: input_tokens forwards any top-level members
request:
  path: /openai/v1/responses/input_tokens
  body: '{"model":"gpt-5","input":[{"role":"user","content":"a"}],"tools":[],"instructions":null}'
mocks:
- request:
    path: /v1/responses/input_tokens
    body: '{"model":"gpt-5","input":[{"role":"user","content":"a"}],"tools":[],"instructions":null}'
---
name: input_tokens with an empty object
request: {path: /openai/v1/responses/input_tokens, body: '{}'}
mocks:
- request: {path: /v1/responses/input_tokens, body: '{}'}
---
name: input_tokens does not check stream
request: {path: /openai/v1/responses/input_tokens, body: '{"model":"gpt-5","stream":1}'}
mocks:
- request: {path: /v1/responses/input_tokens, body: '{"model":"gpt-5","stream":1}'}
---
# the BOM is dropped before the body goes upstream, as on the Anthropic routes
name: BOM before the object is dropped upstream
request: {body: !delete , body_base64: 77u/eyJtb2RlbCI6ImdwdC01IiwiaW5wdXQiOiJoaSJ9}
mocks:
- request: {body: '{"model":"gpt-5","input":"hi"}'}
