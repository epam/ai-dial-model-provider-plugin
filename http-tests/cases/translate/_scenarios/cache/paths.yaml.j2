---
name: {{ (mode ~ ": " ~ "no path in is none out") | tojson }}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: {$absent: true}, x-dial-cache-expire-at: {$absent: true}}}
---
name: {{ (mode ~ ": " ~ "cache_control alone is no breakpoint") | tojson }}
request: {json: {system: [{type: text, text: A, cache_control: {type: ephemeral}}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: {$absent: true}, x-dial-cache-expire-at: {$absent: true}}}
