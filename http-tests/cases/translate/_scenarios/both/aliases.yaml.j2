# What the request and the answer say of one thing, together.
---
name: {{ (mode ~ ": " ~ "tool name that was aliased is restored in the answer") | tojson }}
request: {json: {tools: [{name: get weather, input_schema: {type: object}}]}}
mocks:
- request: {json: {tools: [{type: function, name: get_weather_dce3870e, parameters: {type: object}, strict: false}]}}
  response:
    json:
      output: !replace
      - {type: function_call, id: fc_1, call_id: c1, name: get_weather_dce3870e, arguments: '{}', status: completed}
expect: {json: {content: !replace [{type: tool_use, id: c1, name: get weather, input: {}}], stop_reason: tool_use}}
