#!/bin/sh
# Before a push: the code is formatted. Installed by `make install_git_hooks`.
# ponytail: checks the working tree, not the commits being pushed; push from a clean tree, or use --no-verify.
if ! ./gradlew --quiet spotlessCheck; then
    ./gradlew --quiet spotlessApply || exit 1 # not a formatting problem: Gradle's error says what is
    echo "pre-push: spotlessApply reformatted the files above; commit them and push again" >&2
    exit 1
fi
