# The system turns: a turn of its own, and one that clears itself.
---
name: {{ (mode ~ ": " ~ "system turn is a system message in its place") | tojson }}
request: {json: {messages: [{role: user, content: hi}, {role: system, content: Be brief}, {role: user, content: more}]}}
mocks:
- request:
    json:
      input:
      - {}
      - {type: message, role: system, content: [{type: input_text, text: Be brief}]}
      - {type: message, role: user, content: [{type: input_text, text: more}]}
---
name: {{ (mode ~ ": " ~ "system turn of text blocks") | tojson }}
request: {json: {messages: [{role: system, content: [{type: text, text: A}, {type: text, text: B}]}, {role: user, content: hi}]}}
mocks:
- request:
    json:
      input: !replace
      - {type: message, role: system, content: [{type: input_text, text: A}, {type: input_text, text: B}]}
      - {type: message, role: user, content: [{type: input_text, text: hi}]}
---
name: {{ (mode ~ ": " ~ "empty system turn is nothing") | tojson }}
request: {json: {messages: [{role: system, content: ''}, {role: user, content: hi}]}}
---
name: {{ (mode ~ ": " ~ "system turn that clears itself is dropped once a user message follows") | tojson }}
request: {json: {messages: [{role: system, content: temp, clear_at: next_user_message}, {role: user, content: hi}]}}
---
name: {{ (mode ~ ": " ~ "system turn that clears itself stays while no user message follows") | tojson }}
request: {json: {messages: [{role: user, content: hi}, {role: system, content: temp, clear_at: next_user_message}]}}
mocks:
- request:
    json:
      input:
      - {}
      - {type: message, role: system, content: [{type: input_text, text: temp}]}
---
name: {{ (mode ~ ": " ~ "system turn that never clears stays") | tojson }}
request: {json: {messages: [{role: system, content: keep, clear_at: never}, {role: user, content: hi}]}}
mocks:
- request:
    json:
      input: !replace
      - {type: message, role: system, content: [{type: input_text, text: keep}]}
      - {type: message, role: user, content: [{type: input_text, text: hi}]}
