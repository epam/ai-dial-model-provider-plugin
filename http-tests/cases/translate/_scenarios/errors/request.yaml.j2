# A request that cannot be translated is a 400 in the Anthropic API's error body; nothing is sent upstream.
---
name: {{ (mode ~ ": " ~ "body that is not JSON") | tojson }}
request: {json: !delete , body: '{"model":'}
mocks: []
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: {$regex: '^The request body is not valid JSON: '}}}}
---
name: {{ (mode ~ ": " ~ "body that is not an object") | tojson }}
request: {json: !delete , body: '[]'}
mocks: []
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: {$type: string}}}}
---
name: {{ (mode ~ ": " ~ "unknown role") | tojson }}
request: {json: {messages: [{role: tool, content: x}]}}
mocks: []
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: 'Unsupported message role: tool'}}}
---
name: {{ (mode ~ ": " ~ "model of the wrong type") | tojson }}
request: {json: {model: 5}}
mocks: []
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: 'model: has the wrong type'}}}
---
name: {{ (mode ~ ": " ~ "max_tokens of the wrong type") | tojson }}
request: {json: {max_tokens: many}}
mocks: []
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: '`max_tokens` is invalid, received many'}}}
---
name: {{ (mode ~ ": " ~ "max_tokens is required") | tojson }}
request: {json: {max_tokens: !delete }}
mocks: []
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: '`max_tokens` is not set'}}}
---
name: {{ (mode ~ ": " ~ "temperature of the wrong type") | tojson }}
request: {json: {temperature: hot}}
mocks: []
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: 'temperature: must be a number'}}}
---
name: {{ (mode ~ ": " ~ "no messages") | tojson }}
request: {json: {messages: !delete }}
mocks: []
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: {$type: string}}}}
---
name: {{ (mode ~ ": " ~ "stream flag of the wrong type") | tojson }}
request: {json: {stream: 'yes'}}
mocks: []
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: 'stream: must be a boolean'}}}
---
name: {{ (mode ~ ": " ~ "no deployment header is a failure of DIAL Core, not of the request") | tojson }}
request: {headers: {X-DIAL-DEPLOYMENT-ID: !delete }}
mocks: []
expect: {status: 500, json: !replace {type: error, error: {type: api_error, message: Internal server error}}}
