# The reasoning of the answer: the thinking blocks.
---
name: {{ (mode ~ ": " ~ "reasoning with a summary and encrypted content is a signed thinking block") | tojson }}
mocks:
- response:
    json:
      output: !replace
      - {type: reasoning, id: rs_1, summary: [{type: summary_text, text: Let me see}], encrypted_content: ENC}
      - {type: message, id: m1, role: assistant, status: completed, content: [{type: output_text, text: Hello, annotations: []}]}
expect:
  json:
    content: !replace
    - {type: thinking, thinking: Let me see, signature: !ref /_lib/translate.yaml:signature}
    - {type: text, text: Hello, citations: null}
---
name: {{ (mode ~ ": " ~ "reasoning with only encrypted content is a redacted thinking block") | tojson }}
mocks:
- response:
    json:
      output: !replace
      - {type: reasoning, id: rs_1, summary: [], encrypted_content: ENC}
      - {type: message, id: m1, role: assistant, status: completed, content: [{type: output_text, text: Hello, annotations: []}]}
expect:
  json:
    content: !replace
    - {type: redacted_thinking, data: !ref /_lib/translate.yaml:signature}
    - {type: text, text: Hello, citations: null}
---
name: {{ (mode ~ ": " ~ "reasoning with only text is an unsigned thinking block") | tojson }}
mocks:
- response:
    json:
      output: !replace
      - {type: reasoning, id: rs_1, summary: [{type: summary_text, text: Hm}]}
      - {type: message, id: m1, role: assistant, status: completed, content: [{type: output_text, text: Hello, annotations: []}]}
expect: {json: {content: !replace [{type: thinking, thinking: Hm, signature: ''}, {type: text, text: Hello, citations: null}]}}
---
name: {{ (mode ~ ": " ~ "reasoning with neither is nothing") | tojson }}
mocks:
- response:
    json:
      output: !replace
      - {type: reasoning, id: rs_1, summary: []}
      - {type: message, id: m1, role: assistant, status: completed, content: [{type: output_text, text: Hello, annotations: []}]}
---
name: {{ (mode ~ ": " ~ "summary and content texts of the reasoning are joined by a blank line") | tojson }}
mocks:
- response:
    json:
      output: !replace
      - type: reasoning
        id: rs_1
        summary: [{type: summary_text, text: One}, {type: summary_text, text: Two}]
        content: [{type: reasoning_text, text: Three}]
expect: {json: {content: !replace [{type: thinking, thinking: "One\n\nTwo\n\nThree", signature: ''}]}}
