# The answer of the upstream: the message the client gets.
---
name: {{ (mode ~ ": " ~ "text") | tojson }}
---
name: {{ (mode ~ ": " ~ "the message is named by the deployment, not by the request") | tojson }}
request: {headers: {X-DIAL-OVERRIDE-NAME: other}, json: {model: another-model}}
{% if mode == "adapter" %}
mocks: [{request: {json: {model: another-model}}}]
{% endif %}
expect: {json: {model: gpt-5.5}}
---
name: {{ (mode ~ ": " ~ "output texts are text blocks, in order") | tojson }}
mocks:
- response:
    json:
      output: !replace
      - {type: message, id: m1, role: assistant, status: completed, content: [{type: output_text, text: One, annotations: []}, {type: output_text, text: Two, annotations: []}]}
expect: {json: {content: [{type: text, text: One, citations: null}, {type: text, text: Two, citations: null}]}}
---
name: {{ (mode ~ ": " ~ "no output is one empty text block") | tojson }}
mocks: [{response: {json: {output: !replace []}}}]
expect: {json: {content: [{type: text, text: '', citations: null}]}}
---
name: {{ (mode ~ ": " ~ "an output item the translator does not know is dropped") | tojson }}
mocks:
- response:
    json:
      output: !replace
      - {type: future_item, id: f1}
      - {type: message, id: m1, role: assistant, status: completed, content: [{type: output_text, text: Hello, annotations: []}]}
---
name: {{ (mode ~ ": " ~ "a content part the translator does not know is dropped") | tojson }}
mocks:
- response:
    json:
      output: !replace
      - {type: message, id: m1, role: assistant, status: completed, content: [{type: future_part, a: 1}, {type: output_text, text: Hello, annotations: []}]}
---
name: {{ (mode ~ ": " ~ "usage is the tokens of the response") | tojson }}
mocks: [{response: {json: {usage: {input_tokens: 7, output_tokens: 3, input_tokens_details: {cached_tokens: 0, cache_write_tokens: 0}, output_tokens_details: {reasoning_tokens: 0}}}}}]
expect: {json: {usage: {input_tokens: 7, output_tokens: 3, cache_read_input_tokens: 0, cache_creation_input_tokens: 0, output_tokens_details: {thinking_tokens: 0}}}}
---
name: {{ (mode ~ ": " ~ "no usage is zero tokens") | tojson }}
mocks: [{response: {json: {usage: !delete }}}]
expect: {json: {usage: !replace {input_tokens: 0, output_tokens: 0, cache_read_input_tokens: null, cache_creation_input_tokens: null, output_tokens_details: null, cache_creation: null, inference_geo: null, server_tool_use: null, service_tier: null, speed: null}}}
---
name: {{ (mode ~ ": " ~ "refusal is a text block") | tojson }}
mocks:
- response:
    json:
      output: !replace
      - {type: message, id: m1, role: assistant, status: completed, content: [{type: refusal, refusal: I cannot}]}
expect: {json: {content: [{type: text, text: I cannot, citations: null}], stop_reason: refusal}}
