# What the upstream answers with a failure: the same status, in the Anthropic API's error body, with its message and its
# headers.
---
name: {{ (mode ~ ": " ~ "upstream error keeps its status and message") | tojson }}
mocks:
- response:
    status: 429
    headers: {Retry-After: '7'}
    json: !replace {error: {message: slow down, type: rate_limit_exceeded}}
expect:
  status: 429
  headers: {retry-after: '7', content-type: application/json}
  json: !replace {type: error, error: {type: rate_limit_error, message: slow down}}
---
name: {{ (mode ~ ": " ~ "upstream error type follows the status, 400") | tojson }}
mocks: [{response: {status: 400, json: !replace {error: {message: bad}}}}]
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: bad}}}
---
name: {{ (mode ~ ": " ~ "upstream error type follows the status, 401") | tojson }}
mocks: [{response: {status: 401, json: !replace {error: {message: 'no'}}}}]
expect: {status: 401, json: !replace {type: error, error: {type: authentication_error, message: 'no'}}}
---
name: {{ (mode ~ ": " ~ "upstream error type follows the status, 403") | tojson }}
mocks: [{response: {status: 403, json: !replace {error: {message: 'no'}}}}]
expect: {status: 403, json: !replace {type: error, error: {type: permission_error, message: 'no'}}}
---
name: {{ (mode ~ ": " ~ "upstream error type follows the status, 404") | tojson }}
mocks: [{response: {status: 404, json: !replace {error: {message: 'no'}}}}]
expect: {status: 404, json: !replace {type: error, error: {type: not_found_error, message: 'no'}}}
---
name: {{ (mode ~ ": " ~ "upstream error type follows the status, 413") | tojson }}
mocks: [{response: {status: 413, json: !replace {error: {message: big}}}}]
expect: {status: 413, json: !replace {type: error, error: {type: request_too_large, message: big}}}
---
name: {{ (mode ~ ": " ~ "upstream error type follows the status, another 4xx") | tojson }}
mocks: [{response: {status: 422, json: !replace {error: {message: odd}}}}]
expect: {status: 422, json: !replace {type: error, error: {type: invalid_request_error, message: odd}}}
---
name: {{ (mode ~ ": " ~ "upstream error type follows the status, 500") | tojson }}
mocks: [{response: {status: 500, json: !replace {error: {message: boom}}}}]
expect: {status: 500, json: !replace {type: error, error: {type: api_error, message: boom}}}
---
name: {{ (mode ~ ": " ~ "upstream error type follows the status, 503") | tojson }}
mocks: [{response: {status: 503, json: !replace {error: {message: busy}}}}]
expect: {status: 503, json: !replace {type: error, error: {type: overloaded_error, message: busy}}}
---
name: {{ (mode ~ ": " ~ "upstream error type follows the status, 504") | tojson }}
mocks: [{response: {status: 504, json: !replace {error: {message: late}}}}]
expect: {status: 504, json: !replace {type: error, error: {type: timeout_error, message: late}}}
---
name: {{ (mode ~ ": " ~ "upstream error that is not JSON is the message") | tojson }}
mocks: [{response: {status: 502, headers: {Content-Type: text/plain}, body: bad gateway, json: !delete }}]
expect: {status: 502, json: !replace {type: error, error: {type: api_error, message: bad gateway}}}
---
name: {{ (mode ~ ": " ~ "upstream error JSON without a message is the message") | tojson }}
mocks: [{response: {status: 500, json: !replace {detail: nope}}}]
expect: {status: 500, json: !replace {type: error, error: {type: api_error, message: '{"detail":"nope"}'}}}
---
name: {{ (mode ~ ": " ~ "upstream error without a body has a default message") | tojson }}
mocks: [{response: {status: 500, body: '', json: !delete }}]
expect: {status: 500, json: !replace {type: error, error: {type: api_error, message: The Responses API handler answered 500}}}
---
name: {{ (mode ~ ": " ~ "failed response is an error") | tojson }}
mocks: [{response: {json: {status: failed, error: {code: server_error, message: boom}}}}]
expect: {status: 500, json: !replace {type: error, error: {type: api_error, message: boom}}}
---
name: {{ (mode ~ ": " ~ "failed response without an error") | tojson }}
mocks: [{response: {json: {status: failed}}}]
expect: {status: 500, json: !replace {type: error, error: {type: api_error, message: The Responses API response has failed}}}

---
name: {{ (mode ~ ": " ~ "failed response of a rate limit is a 429") | tojson }}
mocks: [{response: {json: {status: failed, error: {code: rate_limit_exceeded, message: slow}}}}]
expect: {status: 429, json: !replace {type: error, error: {type: rate_limit_error, message: slow}}}
---
name: {{ (mode ~ ": " ~ "failed response of a vector store timeout is a 504") | tojson }}
mocks: [{response: {json: {status: failed, error: {code: vector_store_timeout, message: late}}}}]
expect: {status: 504, json: !replace {type: error, error: {type: timeout_error, message: late}}}
---
name: {{ (mode ~ ": " ~ "failed response of an invalid prompt is a 400") | tojson }}
mocks: [{response: {json: {status: failed, error: {code: invalid_prompt, message: bad prompt}}}}]
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: bad prompt}}}
---
name: {{ (mode ~ ": " ~ "failed response of a context that is too long is a 400") | tojson }}
mocks: [{response: {json: {status: failed, error: {code: context_length_exceeded, message: long}}}}]
expect: {status: 400, json: !replace {type: error, error: {type: invalid_request_error, message: long}}}
---
name: {{ (mode ~ ": " ~ "failed response of a code the translator does not know is a 500") | tojson }}
mocks: [{response: {json: {status: failed, error: {code: future_code, message: odd}}}}]
expect: {status: 500, json: !replace {type: error, error: {type: api_error, message: odd}}}
