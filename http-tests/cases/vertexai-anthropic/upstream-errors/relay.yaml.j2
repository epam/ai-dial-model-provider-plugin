# How an upstream's error answer reaches the client, on each upstream the vertexai adapter picks, streaming or not:
# the status and body as received, and only Retry-After, Retry-After-Ms, Content-Type and Content-Encoding of the
# headers. The error is read whole, so a streaming request gets it as a plain JSON answer, not an event stream.
{% set upstreams = {
  "vertex": {
    "env": {},
    "headers": {},
    "path": "/vertex/projects/p/locations/us-east5/publishers/anthropic/models/claude-x:",
    "plain": "rawPredict",
    "stream": "streamRawPredict",
  },
  "foundry": {
    "env": {},
    "headers": {"X-Upstream-Endpoint": "${mocks.upstream.url}/anthropic/v1/messages", "X-Upstream-Key": "k"},
    "path": "/anthropic/v1/messages",
    "plain": "",
    "stream": "",
  },
  "platform": {
    "env": {"ANTHROPIC_BASE_URL": "${mocks.upstream.url}/platform"},
    "headers": {"X-Upstream-Key": "k"},
    "path": "/platform/v1/messages",
    "plain": "",
    "stream": "",
  },
} %}
{% set errors = [
  [400, "invalid_request_error", "max_tokens: Field required"],
  [401, "authentication_error", "invalid x-api-key"],
  [403, "permission_error", "forbidden"],
  [404, "not_found_error", "model: claude-x"],
  [429, "rate_limit_error", "slow down"],
  [500, "api_error", "Internal server error"],
  [529, "overloaded_error", "Overloaded"],
] %}
{% for cloud, u in upstreams.items() %}
{% for status, kind, message in errors %}
{% for stream in [false, true] %}
{% set body = {"type": "error", "error": {"type": kind, "message": message}} %}
---
name: {{ (cloud ~ " " ~ status ~ (" streaming" if stream else "")) | tojson }}
server: {env: {{ u.env | tojson }}}
request:
  headers: {{ u.headers | tojson }}
  body: {{ ('{"model":"claude-x",' ~ ('"stream":true,' if stream else '') ~ '"messages":[]}') | tojson }}
mocks:
- request:
    path: {{ (u.path ~ (u.stream if stream else u.plain)) | tojson }}
    body: !delete
  response:
    status: {{ status }}
    headers: {Content-Type: application/json, X-Junk: '1', Request-Id: req_1}
    json: {{ body | tojson }}
expect:
  status: {{ status }}
  headers: {content-type: application/json, x-junk: {$absent: true}, request-id: {$absent: true}, x-dial-*: {$absent: true}}
  json: {{ body | tojson }}
{% endfor %}
{% endfor %}
{% endfor %}
