---
name: {{ (mode ~ ": " ~ "count_tokens is not served for a Responses API upstream") | tojson }}
request: {path: /anthropic/v1/messages/count_tokens}
mocks: []
expect: {status: 404, json: !replace {type: error, error: {type: not_found_error, message: Endpoint not supported}}}
---
name: {{ (mode ~ ": " ~ "a Messages API upstream is served by the passthrough") | tojson }}
request: {headers: {X-Upstream-Endpoint: '${mocks.upstream.url}/provider/v1/messages'}}
mocks:
- request:
    path: /provider/v1/messages
    headers: {x-api-key: k, authorization: {$absent: true}}
    json: !replace {model: claude-x, max_tokens: 100, messages: [{role: user, content: hi}]}
  response: {headers: {Content-Type: application/json}, json: !replace {id: msg_1, type: message, role: assistant, content: [{type: text, text: Hello}]}}
expect: {json: !replace {id: msg_1, type: message, role: assistant, content: [{type: text, text: Hello}]}}
---
name: {{ (mode ~ ": " ~ "an upstream of neither API is refused") | tojson }}
request: {headers: {X-Upstream-Endpoint: 'http://h.invalid/messages'}}
mocks: []
expect: {status: 502, json: !replace {type: error, error: {type: api_error, message: Invalid upstream endpoint format}}}
