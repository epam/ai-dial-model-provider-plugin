# The cache affinity of DIAL Core: its paths are those of the body it sent, so each is carried over to the other API's
# body (CacheHeaders, whose values CacheHeadersTest pins). Of the Responses call's header the upstream sees nothing here:
# the Responses route only asks whether it is there, and then stamps its answer with the last item of its input (or the
# instructions), which is carried back to the Messages body, with the expiry. So a path of the request that names no
# position of the Responses request is left out, and the answer is not stamped.
# --- The answer: the last item of the input is the last block that went into it
---
name: {{ (mode ~ ": " ~ "the last item is the last block that went into it") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: "prefix.body.messages[0].content[0]"}, json: {"messages": [{"role": "user", "content": [{"type": "text", "text": "a"}, {"type": "text", "text": "b"}]}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: "prefix.body.messages[0].content[1]", x-dial-cache-expire-at: "1300"}}
---
name: {{ (mode ~ ": " ~ "a string content is the first block") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: "prefix.body.messages[0].content[0]"}, json: {"messages": [{"role": "user", "content": "hi"}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: "prefix.body.messages[0].content[0]", x-dial-cache-expire-at: "1300"}}
---
name: {{ (mode ~ ": " ~ "the last item is the last message's") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: "prefix.body.messages[2].content[0]"}, json: {"messages": [{"role": "user", "content": "hi"}, {"role": "assistant", "content": "Hello"}, {"role": "user", "content": "more"}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: "prefix.body.messages[2].content[0]", x-dial-cache-expire-at: "1300"}}
---
name: {{ (mode ~ ": " ~ "the instructions are the last system block") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: "prefix.body.system[0]"}, json: {"system": [{"type": "text", "text": "A"}, {"type": "text", "text": "B"}], "messages": [{"role": "user", "content": ""}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: "prefix.body.system[1]", x-dial-cache-expire-at: "1300"}}
---
name: {{ (mode ~ ": " ~ "the instructions are the system string") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: "prefix.body.system[0]"}, json: {"system": "Be brief", "messages": [{"role": "user", "content": ""}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: "prefix.body.system[0]", x-dial-cache-expire-at: "1300"}}
---
name: {{ (mode ~ ": " ~ "a system turn that clears itself but has no user message after it is an item") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: 'prefix.body.messages[0].content[0]'}, json: {messages: [{role: user, content: hi}, {role: system, content: temp, clear_at: next_user_message}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: 'prefix.body.messages[1].content[0]', x-dial-cache-expire-at: '1300'}}
---
name: {{ (mode ~ ": " ~ "a system turn that cleared itself holds no item") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: 'prefix.body.messages[1].content[0]'}, json: {messages: [{role: system, content: temp, clear_at: next_user_message}, {role: user, content: hi}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: 'prefix.body.messages[1].content[0]', x-dial-cache-expire-at: '1300'}}
---
name: {{ (mode ~ ": " ~ "an item that has several blocks is the last of them") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: "prefix.body.messages[0].content[0]"}, json: {"messages": [{"role": "user", "content": "hi"}, {"role": "assistant", "content": [{"type": "text", "text": "a"}, {"type": "tool_use", "id": "t1", "name": "f", "input": {}}, {"type": "text", "text": "b"}, {"type": "text", "text": "c"}]}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: "prefix.body.messages[1].content[3]", x-dial-cache-expire-at: "1300"}}
---
name: {{ (mode ~ ": " ~ "the output item and the user text after it: the text is the last item") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: "prefix.body.messages[2].content[0]"}, json: {"messages": [{"role": "user", "content": "hi"}, {"role": "assistant", "content": [{"type": "tool_use", "id": "t1", "name": "f", "input": {}}]}, {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "t1", "content": "ok"}, {"type": "text", "text": "go"}]}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: "prefix.body.messages[2].content[1]", x-dial-cache-expire-at: "1300"}}
---
name: {{ (mode ~ ": " ~ "the expiry is the upstream's") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: "prefix.body.messages[0].content[0]"}, json: {"messages": [{"role": "user", "content": "hi"}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: "prefix.body.messages[0].content[0]", x-dial-cache-expire-at: "1300"}}
# --- No path in is none out
---
name: {{ (mode ~ ": " ~ "a path of a position the request has not is no breakpoint") | tojson }}
request: {headers: {X-Dial-Cache-Breakpoint-Path: "prefix.body.tools[5]"}, json: {"tools": [{"name": "f", "input_schema": {"type": "object"}}]}}
mocks: [{request: {json: {$partial: {store: false}}}}]
expect: {headers: {x-dial-cache-breakpoint-path: {$absent: true}, x-dial-cache-expire-at: {$absent: true}}}
---
name: {{ (mode ~ ": " ~ "a path that is no path of the Messages body is no breakpoint") | tojson }}
