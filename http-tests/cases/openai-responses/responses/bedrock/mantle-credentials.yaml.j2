# Bedrock Mantle without a key: SigV4 with the extra data's keys (else the environment's, else the default chain,
# stubbed as AKID), the environment bearer token, and the failures answered before any call; with a key a bearer token.
{% set signed = "^AWS4-HMAC-SHA256 Credential=" %}
---
name: mantle key is a bearer token and nothing is signed
mocks:
- request: {headers: {authorization: Bearer k, x-amz-date: {$absent: true}, x-amz-content-sha256: {$absent: true}, x-amz-security-token: {$absent: true}}}
---
name: mantle key with the alibaba-cloud vendor
request:
  headers: {X-Upstream-Extra-Data: '{"vendor":"alibaba-cloud","headers_to_proxy":["x-trace"]}', X-Trace: t1}
mocks:
- request: {headers: {authorization: Bearer k, x-dashscope-session-cache: enable, x-trace: t1}}
---
name: mantle key next to a partial set of aws members stays a bearer token
request: {headers: {X-Upstream-Extra-Data: '{"aws_access_key_id":"AKID2"}'}}
mocks:
- request: {headers: {authorization: Bearer k, x-amz-date: {$absent: true}}}
---
name: mantle default chain signs the request
request: {headers: {X-Upstream-Key: !delete }}
mocks:
- request:
    headers:
      authorization: {$regex: '{{ signed }}AKID/\d{8}/us-east-1/bedrock-mantle/aws4_request, '}
      x-amz-content-sha256: 49bb5ce66b2215f7193979d0ab5c1088e42046dcd9546f0e0780f3eb628e2721
      x-amz-security-token: {$absent: true}
---
name: mantle static keys and session token from extra data
request:
  headers:
    X-Upstream-Key: !delete
    X-Upstream-Extra-Data: '{"aws_access_key_id":"AKID2","aws_secret_access_key":"secret2","aws_session_token":"TOK"}'
mocks:
- request:
    headers:
      authorization: {$regex: '{{ signed }}AKID2/\d{8}/us-east-1/bedrock-mantle/aws4_request, '}
      x-amz-security-token: TOK
---
name: mantle keys from the environment
server: {env: {AWS_ACCESS_KEY_ID: AKIDENV, AWS_SECRET_ACCESS_KEY: envsecret}}
request: {headers: {X-Upstream-Key: !delete }}
mocks:
- request: {headers: {authorization: {$regex: '{{ signed }}AKIDENV/'}}}
---
name: mantle extra data overrides the environment per member
server: {env: {AWS_ACCESS_KEY_ID: AKIDENV, AWS_SECRET_ACCESS_KEY: envsecret}}
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":"AKID2"}'}}
mocks:
- request: {headers: {authorization: {$regex: '{{ signed }}AKID2/'}}}
---
name: mantle null and empty clear the environment's keys
server: {env: {AWS_ACCESS_KEY_ID: AKIDENV, AWS_SECRET_ACCESS_KEY: envsecret}}
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":null,"aws_secret_access_key":""}'}}
mocks:
- request: {headers: {authorization: {$regex: '{{ signed }}AKID/'}}}
---
name: mantle keys that are not a pair are left out
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":"AKID2","aws_session_token":"TOK"}'}}
mocks:
- request: {headers: {authorization: {$regex: '{{ signed }}AKID/'}, x-amz-security-token: {$absent: true}}}
---
name: mantle environment bearer token
server: {env: {AWS_BEARER_TOKEN_BEDROCK: envtok}}
request: {headers: {X-Upstream-Key: !delete }}
mocks:
- request: {headers: {authorization: Bearer envtok, x-amz-date: {$absent: true}}}
---
name: mantle configured keys win over the environment bearer token
server: {env: {AWS_BEARER_TOKEN_BEDROCK: envtok}}
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":"AKID2","aws_secret_access_key":"secret2"}'}}
mocks:
- request: {headers: {authorization: {$regex: '{{ signed }}AKID2/'}}}
---
name: mantle signs a stream
request:
  headers: {X-Upstream-Key: !delete }
  body: '{"model":"m","stream":true,"input":"hi"}'
mocks:
- request:
    headers: {authorization: {$regex: '{{ signed }}AKID/'}}
    body: '{"model":"m","stream":true,"input":"hi"}'
  response: {headers: {Content-Type: text/event-stream}, body: "data: 1\n\n"}
expect: {headers: {content-type: text/event-stream}, body: "data: 1\n\n"}
---
name: mantle signs a retrieve over the empty body
request: {method: GET, path: /openai/v1/responses/resp_1, headers: {X-Upstream-Key: !delete }, body: !delete }
mocks:
- request:
    method: GET
    path: /openai/v1/responses/resp_1
    headers:
      authorization: {$regex: '{{ signed }}AKID/'}
      x-amz-content-sha256: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    body: ''
---
name: mantle with the alibaba-cloud vendor and no key is a 502
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"vendor":"alibaba-cloud","aws_access_key_id":"A"}'}}
mocks: []
expect: {status: 502, json: {error: {message: X-UPSTREAM-KEY header is missing in the request., type: internal_server_error, code: '502'}}}
---
name: mantle empty key names the api_key argument
request: {headers: {X-Upstream-Key: ''}}
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: "The `api_key` argument must not be empty."}}
---
name: mantle empty key comes before a proxied Authorization
request:
  headers: {X-Upstream-Key: '', X-Upstream-Extra-Data: '{"headers_to_proxy":["Authorization"]}', Authorization: Bearer user}
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: "The `api_key` argument must not be empty."}}
---
name: mantle proxied Authorization with a key
request:
  headers: {X-Upstream-Extra-Data: '{"headers_to_proxy":["Authorization"]}', Authorization: Bearer user}
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: "Bedrock provider authentication cannot be combined with a custom `Authorization` header."}}
---
name: mantle Authorization named but not sent
request: {headers: {X-Upstream-Extra-Data: '{"headers_to_proxy":["Authorization"]}'}}
mocks:
- request: {headers: {authorization: Bearer k}}
---
name: mantle blank key id
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":" ","aws_secret_access_key":"secret2"}'}}
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: "Static AWS credentials require non-empty `access_key_id` and `secret_access_key` values."}}
---
name: mantle blank session token
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":"AKID2","aws_secret_access_key":"secret2","aws_session_token":" "}'}}
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: "A static AWS `session_token` must not be empty when provided."}}
---
name: mantle blank environment bearer token
server: {env: {AWS_BEARER_TOKEN_BEDROCK: ' '}}
request: {headers: {X-Upstream-Key: !delete }}
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: The Bedrock bearer credential must not be empty.}}
---
name: mantle blank credentials come before a proxied Authorization
request:
  headers:
    X-Upstream-Key: !delete
    X-Upstream-Extra-Data: '{"aws_access_key_id":" ","aws_secret_access_key":"s","headers_to_proxy":["Authorization"]}'
    Authorization: Bearer user
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: "Static AWS credentials require non-empty `access_key_id` and `secret_access_key` values."}}
---
name: mantle body is checked before blank credentials
request:
  headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":" ","aws_secret_access_key":"s"}'}
  body: '{"model":'
mocks: []
expect: {status: 400, json: {error: {message: {$regex: '^The request body is not valid JSON'}, type: invalid_request_error, code: '400'}}}
---
name: mantle extra data is checked before the credentials
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":1}'}}
mocks: []
expect: {status: 502, json: {error: {$partial: {type: internal_server_error, code: '502'}}}}
---
name: mantle base URL in another region is refused when signing
server: {env: {AWS_BEDROCK_BASE_URL: 'http://bedrock-mantle.eu-west-1.api.aws/openai/v1'}}
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":"AKID2","aws_secret_access_key":"secret2"}'}}
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: "The Bedrock endpoint region `eu-west-1` does not match the SigV4 region `us-east-1`."}}
---
name: mantle region check lowercases the host and drops the port
server: {env: {AWS_BEDROCK_BASE_URL: 'http://BEDROCK-MANTLE.EU-WEST-1.API.AWS:8443/openai/v1'}}
request: {headers: {X-Upstream-Key: !delete , X-Upstream-Extra-Data: '{"aws_access_key_id":"AKID2","aws_secret_access_key":"secret2"}'}}
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: "The Bedrock endpoint region `eu-west-1` does not match the SigV4 region `us-east-1`."}}
---
name: mantle region check comes after a proxied Authorization
server: {env: {AWS_BEDROCK_BASE_URL: 'http://bedrock-mantle.eu-west-1.api.aws/openai/v1'}}
request:
  headers:
    X-Upstream-Key: !delete
    X-Upstream-Extra-Data: '{"aws_access_key_id":"AKID2","aws_secret_access_key":"secret2","headers_to_proxy":["Authorization"]}'
    Authorization: Bearer user
mocks: []
expect:
  status: 500
  json: {error: {code: '500', type: internal_server_error, message: "Bedrock provider authentication cannot be combined with a custom `Authorization` header."}}
---
name: mantle base URL with a trailing slash
server: {env: {AWS_BEDROCK_BASE_URL: '${mocks.upstream.url}/openai/v1/'}}
---
name: mantle base URL cut at /responses
server: {env: {AWS_BEDROCK_BASE_URL: '${mocks.upstream.url}/openai/v1/responses/zz'}}
---
name: mantle ignores the endpoint's scheme and path
request: {headers: {X-Upstream-Endpoint: 'http://bedrock-mantle.us-east-1.api.aws/x/y/responses'}}
---
name: mantle retrieve goes to the base URL
request: {method: GET, path: /openai/v1/responses/resp_1, body: !delete }
mocks:
- request: {method: GET, path: /openai/v1/responses/resp_1, body: ''}
