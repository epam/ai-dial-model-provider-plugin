# Cloud settings of the integration tests (make integration-tests, make integration-tests-smoke), read from here or
# from the environment (the environment wins). Copy to .env, which is git-ignored.
# make docker passes the same file to the service as its environment.

# AWS: Bedrock (Claude through invoke-model and Mantle, GPT through Mantle). The profile is any SDK credential source:
# `aws sso login --profile <profile>` for an SSO one.
AWS_PROFILE=<aws profile with Bedrock model access>
AWS_DEFAULT_REGION=us-east-1

# GCP: Vertex AI, Claude (from the global endpoint). Credentials are Application Default Credentials:
# `gcloud auth application-default login`.
GCP_PROJECT_ID=<project with the Claude models enabled>

# Azure needs no variable here: `az login` (the DefaultAzureCredential fallback) and integration-tests/azure.local.json.
